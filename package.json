{
  "name": "command-vault",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* run dev",
    "dev:api": "pnpm --filter @command-vault/api run dev",
    "dev:web": "pnpm --filter @command-vault/web run dev",
    "db:generate": "pnpm --filter @command-vault/api run db:generate",
    "db:migrate": "pnpm --filter @command-vault/api run db:migrate",
    "db:seed": "pnpm --filter @command-vault/api run db:seed",
    "db:studio": "pnpm --filter @command-vault/api run db:studio",
    "build": "pnpm --filter @command-vault/shared run build && pnpm --filter @command-vault/api run build && pnpm --filter @command-vault/web run build"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.29.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild"
    ]
  }
}
